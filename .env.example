# Copy to .env for local npm dev. Docker Compose reads this file too.
# The app runs with every key below empty. Production (NODE_ENV=production) requires
# MONGODB_URI, JWT_SECRET, and ENCRYPTION_KEY.

# --- API (NestJS) ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/rto-shield
JWT_SECRET=
ENCRYPTION_KEY=
# Comma-separated. Production: https://www.rtoshield.tech
# Add localhost when a local web app calls a remote API:
# https://www.rtoshield.tech,http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Production public URL: https://ml.rtoshield.tech
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
JSON_LIMIT=6mb
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SERPAPI_KEY=
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
BCRYPT_ROUNDS=12

# --- Web (Next.js) ---
# Server-side proxy target. The browser always calls same-origin /api.
# On Vercel set this to https://api.rtoshield.tech (no trailing slash). Do not expose it.
API_URL=http://localhost:4000
# Optional. On Vercel set https://ml.rtoshield.tech/health so the landing page
# wakes the ML service in parallel with the same-origin /api/health/ml pass-through.
NEXT_PUBLIC_ML_HEALTH_URL=
NEXT_PUBLIC_SENTRY_DSN=

# --- ML (FastAPI) ---
# Extra browser origins for GET /health, comma-separated.
# https://www.rtoshield.tech and http://localhost:3000 are allowed by default.
ML_CORS_ORIGINS=
TABPFN_TOKEN=
TABPFN_MAX_ROWS=500
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:4b
MIN_TRAIN_ROWS=30
