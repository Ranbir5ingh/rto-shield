# Copy to .env for local npm dev. Docker Compose reads this file too.
# The app runs with every key below empty. Production (NODE_ENV=production) requires
# MONGODB_URI, JWT_SECRET, and ENCRYPTION_KEY.

# --- API (NestJS) ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/rto-shield
JWT_SECRET=
ENCRYPTION_KEY=
# Comma-separated. Production: https://www.rtoshield.tech
# Add localhost when a local web app calls a remote API:
# https://www.rtoshield.tech,http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Production public URL: https://ml.rtoshield.tech
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
JSON_LIMIT=6mb
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_URL=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SERPAPI_KEY=
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
BCRYPT_ROUNDS=12
# 64 hex chars or a long passphrase. Wraps per-record data keys for Shopify, WhatsApp, and Gemini secrets.
# Do not commit a real value. Production refuses to store those secrets until this is set.
KEY_ENCRYPTION_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://www.rtoshield.tech
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,read_customers
SHOPIFY_API_VERSION=2026-10
INBOX_DRAIN_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- Web (Next.js) ---
# Server-side proxy target. The browser always calls same-origin /api.
# On Vercel set this to https://api.rtoshield.tech (no trailing slash). Do not expose it.
API_URL=http://localhost:4000
# Public Shopify client id for the embedded App Bridge page. Same value as SHOPIFY_API_KEY, never the secret.
NEXT_PUBLIC_SHOPIFY_API_KEY=
# Vercel also needs MONGODB_URI, ENCRYPTION_KEY, SHOPIFY_API_SECRET, INBOX_DRAIN_SECRET,
# WHATSAPP_VERIFY_TOKEN, and KEY_ENCRYPTION_KEY so the webhook routes can verify and store events.
# Optional. On Vercel set https://ml.rtoshield.tech/health so the landing page
# wakes the ML service in parallel with the same-origin /api/health/ml pass-through.
NEXT_PUBLIC_ML_HEALTH_URL=
NEXT_PUBLIC_SENTRY_DSN=

# --- ML (FastAPI) ---
# Extra browser origins for GET /health, comma-separated.
# https://www.rtoshield.tech and http://localhost:3000 are allowed by default.
ML_CORS_ORIGINS=
TABPFN_TOKEN=
TABPFN_MAX_ROWS=500
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:4b
MIN_TRAIN_ROWS=30
